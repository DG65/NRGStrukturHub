{
  "elements": [
    {
      "type": "ExpansionPanel",
      "name": "NewsPanel",
      "caption": "🆕 Neu in Version 0.2.0",
      "expanded": true,
      "visible": true,
      "items": [
        {
          "type": "Label",
          "caption": "Neu: Gerüst-Generator (Panel „🏗️ Struktur-Gerüst anlegen“) — legt Etagen-/Raum-Kategorien nach der Verbund-Konvention an, auch in Masse per Präfix+Nummernbereich (privat wie gewerblich). Legt weiterhin keine Geräte-Verknüpfungen an."
        },
        {
          "type": "Label",
          "caption": "Seit 0.1.0: liest die bestehende Objektbaum-Struktur (Etagen/Räume/Geräte-Instanzen) ein und stellt sie anderen NRG-Stack-Modulen als Vertrag (STRUKT_GetStructure) bereit."
        },
        {
          "type": "Button",
          "caption": "Verstanden – nicht mehr anzeigen",
          "onClick": "STRUKT_AckNews($id);"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "📖 Dokumentation & Hilfe",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "StrukturHub macht die bestehende Objektbaum-Struktur einer Symcon-Installation maschinenlesbar. Unten die Wurzelkategorie deiner Räume auswählen (z. B. eine Kategorie „Räume“ oder „Zuhause“) — Beispiel, keine Vorgabe."
        },
        {
          "type": "Label",
          "caption": "Danach erscheinen die direkten Unterkategorien in der Tabelle „Etagen“. Häkchen bei allen setzen, die wirklich eine Etage sind — andere Kategorien auf derselben Ebene (z. B. „Energie“, „Test“) einfach ungehäkelt lassen, sie werden dann ignoriert. Ohne Häkchen gelten die direkten Unterkategorien der Wurzel selbst als Räume (kein Etagen-Layer nötig)."
        },
        {
          "type": "Label",
          "caption": "Als Geräte eines Raums zählen sowohl direkt darin liegende Geräte-Instanzen als auch Verknüpfungen (Links) auf Instanzen an anderer Stelle. Doppelte Verknüpfungen auf dasselbe Gerät und tote/namenlose Links (Ziel existiert nicht mehr) werden automatisch bereinigt."
        },
        {
          "type": "Label",
          "caption": "Vertrag für andere Module: STRUKT_GetStructure($id) liefert einen JSON-STRING (kein PHP-Array!) mit contractVersion/levels/rooms. Immer hinter function_exists('STRUKT_GetStructure') aufrufen."
        },
        {
          "type": "Label",
          "caption": "Gerüst-Generator (Panel weiter unten): Zeilen in „Etagen“/„Räume“ eintragen (frei benennbar — egal ob Etage/Stockwerk/Geschoss, Raum/Büro/Zimmer), bei Bedarf über Präfix+Nummernbereich viele Zeilen auf einmal einfügen. „Vorschau“ zeigt, was passieren würde, ohne etwas anzulegen. „Jetzt anlegen“ erzeugt die Kategorien wirklich — mehrfaches Anlegen mit denselben Zeilen legt nichts doppelt an. Legt KEINE Geräte-Verknüpfungen an, nur das Kategorie-Gerüst."
        }
      ]
    },
    {
      "type": "SelectCategory",
      "name": "RootCategoryID",
      "caption": "Wurzelkategorie der Räume"
    },
    {
      "type": "List",
      "name": "Levels",
      "caption": "Etagen (Häkchen bei allen Etagen-Kategorien setzen)",
      "rowCount": 8,
      "add": false,
      "delete": false,
      "loadValuesFromConfiguration": false,
      "columns": [
        {
          "caption": "Etage?",
          "name": "IsLevel",
          "width": "80px",
          "add": false,
          "edit": { "type": "CheckBox" }
        },
        {
          "caption": "Kategorie",
          "name": "Name",
          "width": "260px",
          "add": ""
        },
        {
          "caption": "Kinder",
          "name": "Kinder",
          "width": "90px",
          "add": 0
        },
        {
          "caption": "Kategorie-ID",
          "name": "CategoryID",
          "width": "110px",
          "add": 0,
          "save": true
        }
      ]
    },
    {
      "type": "Button",
      "caption": "🔎 Struktur jetzt einlesen",
      "onClick": "echo STRUKT_RefreshStructure($id);"
    },
    {
      "type": "Label",
      "name": "StatusLine",
      "caption": "ℹ️ Noch nicht eingelesen."
    },
    {
      "type": "ExpansionPanel",
      "caption": "🔍 Eingelesene Struktur (zur Kontrolle)",
      "expanded": false,
      "items": [
        {
          "type": "List",
          "name": "StructurePreview",
          "caption": "Räume",
          "rowCount": 10,
          "add": false,
          "delete": false,
          "loadValuesFromConfiguration": false,
          "columns": [
            { "caption": "Raum", "name": "Raum", "width": "200px", "add": "" },
            { "caption": "Etage", "name": "Etage", "width": "140px", "add": "" },
            { "caption": "Typ", "name": "Typ", "width": "110px", "add": "" },
            { "caption": "Nummer", "name": "Nummer", "width": "80px", "add": "" },
            { "caption": "Reihe", "name": "Reihe", "width": "70px", "add": 0 },
            { "caption": "Geräte", "name": "Geraete", "width": "70px", "add": 0 }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "🏗️ Struktur-Gerüst anlegen",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Legt für dich Etagen- und Raum-Kategorien nach der Verbund-Konvention an — privat oder gewerblich, alle Begriffe frei wählbar (z. B. „Etage“/„Stockwerk“/„Geschoss“, „Raum“/„Büro“/„Zimmer“). Legt NUR Kategorien an, keine Geräte-Verknüpfungen — die verlinkst du danach wie gewohnt selbst."
        },
        {
          "type": "Label",
          "caption": "1. Etagen (optional — leer lassen für eine flache Struktur ohne Etagen-Ebene):"
        },
        {
          "type": "List",
          "name": "GenLevels",
          "caption": "Etagen",
          "rowCount": 6,
          "add": true,
          "delete": true,
          "columns": [
            { "caption": "Bezeichnung", "name": "Label", "width": "auto", "add": "", "edit": { "type": "ValidationTextBox" } }
          ]
        },
        {
          "type": "RowLayout",
          "items": [
            { "type": "ValidationTextBox", "name": "GenLevelPrefix", "caption": "Präfix (z. B. Etage)" },
            { "type": "NumberSpinner", "name": "GenLevelStart", "caption": "von", "value": 1 },
            { "type": "NumberSpinner", "name": "GenLevelEnd", "caption": "bis", "value": 1 },
            {
              "type": "Select",
              "name": "GenLevelNumberPos",
              "caption": "Nummer",
              "value": "hinten",
              "options": [
                { "caption": "hinten (Etage 1)", "value": "hinten" },
                { "caption": "vorne (1 Etage)", "value": "vorne" }
              ]
            },
            { "type": "Button", "caption": "➕ Einfügen", "onClick": "echo STRUKT_AddLevelRows($id, $GenLevels, $GenLevelPrefix, $GenLevelStart, $GenLevelEnd, $GenLevelNumberPos);" }
          ]
        },
        {
          "type": "Label",
          "caption": "2. Räume (Bezeichnung + optional zugehörige Etage — Text muss exakt zu einer Zeile oben passen, sonst landet der Raum direkt unter der Wurzelkategorie):"
        },
        {
          "type": "List",
          "name": "GenRooms",
          "caption": "Räume",
          "rowCount": 10,
          "add": true,
          "delete": true,
          "columns": [
            { "caption": "Bezeichnung", "name": "Label", "width": "260px", "add": "", "edit": { "type": "ValidationTextBox" } },
            { "caption": "Etage (leer = keine)", "name": "LevelLabel", "width": "auto", "add": "", "edit": { "type": "ValidationTextBox" } }
          ]
        },
        {
          "type": "RowLayout",
          "items": [
            { "type": "ValidationTextBox", "name": "GenRoomPrefix", "caption": "Präfix (z. B. Büro)" },
            { "type": "NumberSpinner", "name": "GenRoomStart", "caption": "von", "value": 1 },
            { "type": "NumberSpinner", "name": "GenRoomEnd", "caption": "bis", "value": 1 },
            {
              "type": "Select",
              "name": "GenRoomNumberPos",
              "caption": "Nummer",
              "value": "hinten",
              "options": [
                { "caption": "hinten (Büro 101)", "value": "hinten" },
                { "caption": "vorne (101 Büro)", "value": "vorne" }
              ]
            },
            { "type": "ValidationTextBox", "name": "GenRoomLevel", "caption": "für Etage (leer = keine)" },
            { "type": "Button", "caption": "➕ Einfügen", "onClick": "echo STRUKT_AddRoomRows($id, $GenRooms, $GenRoomPrefix, $GenRoomStart, $GenRoomEnd, $GenRoomLevel, $GenRoomNumberPos);" }
          ]
        },
        { "type": "Button", "caption": "🔍 Vorschau", "onClick": "echo STRUKT_PreviewSkeleton($id, $GenLevels, $GenRooms);" },
        {
          "type": "List",
          "name": "GenPreview",
          "caption": "Vorschau / Ergebnis",
          "rowCount": 10,
          "add": false,
          "delete": false,
          "loadValuesFromConfiguration": false,
          "values": [],
          "columns": [
            { "caption": "Pfad", "name": "Pfad", "width": "300px", "add": "" },
            { "caption": "Status", "name": "Status", "width": "120px", "add": "" }
          ]
        },
        { "type": "CheckBox", "name": "GenConfirmed", "caption": "Ich habe die Vorschau geprüft" },
        {
          "type": "Button",
          "caption": "🏗️ Jetzt anlegen",
          "confirm": "Legt die oben gelistete Struktur wirklich in deinem Objektbaum an. Fortfahren?",
          "onClick": "echo STRUKT_BuildSkeleton($id, $GenConfirmed, $GenLevels, $GenRooms);"
        },
        { "type": "Label", "name": "GenStatusLine", "caption": "ℹ️ Noch nichts angelegt." }
      ]
    },
    {
      "type": "RowLayout",
      "name": "ForumHint",
      "visible": true,
      "items": [
        { "type": "Label", "caption": "🧪 StrukturHub ist neu — Rückmeldungen sind im Symcon-Forum willkommen:" },
        { "type": "Label", "link": true, "caption": "https://github.com/DG65/NRGStrukturHub" },
        { "type": "Button", "caption": "Nicht mehr anzeigen", "onClick": "STRUKT_DismissForumHint($id);" }
      ]
    }
  ],
  "status": [
    { "code": 102, "icon": "active", "caption": "Aktiv" },
    { "code": 104, "icon": "inactive", "caption": "Wurzelkategorie noch nicht ausgewählt" }
  ]
}
